rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validAccount() {
      return request.resource.data.keys().hasOnly(['name', 'currency', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.currency is string &&
        request.resource.data.currency.matches('^[A-Z]{3}$');
    }
    function validEntry() {
      return request.resource.data.keys().hasOnly(['accountId','kind','amountMinor','note','date','createdAt']) &&
        request.resource.data.accountId is string &&
        request.resource.data.accountId.size() > 0 &&
        request.resource.data.kind in ['income','expense'] &&
        request.resource.data.amountMinor is int &&
        request.resource.data.amountMinor > 0 &&
        request.resource.data.amountMinor <= 100000000000 &&
        request.resource.data.note is string &&
        request.resource.data.note.size() <= 300 &&
        request.resource.data.date is string &&
        request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    match /users/{uid}/accounts/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validAccount();
      allow update: if isOwner(uid) && validAccount() &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }
    match /users/{uid}/entries/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validEntry() &&
        exists(/databases/$(database)/documents/users/$(uid)/accounts/$(request.resource.data.accountId));
      allow update: if false;
      allow delete: if isOwner(uid);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
